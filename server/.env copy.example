PORT=5000
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
# Or MongoDB Atlas (put your own connection string in .env, never commit it):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusconnect
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
